rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'geopro.ec2@gmail.com',
          'dcoellom2@unemi.edu.ec',
          'diogenes.coello@gestionderiesgos.gob.ec'
        ];
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/perfiles/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data;
    }

    function activeProfile() {
      return profileExists() && profile().get('estado', '') == 'Activo';
    }

    function admin() {
      return adminEmail()
        || (activeProfile() && profile().get('rol', '') == 'Administrador');
    }

    function readOnlyProfile() {
      return activeProfile()
        && (
          profile().get('modoAcceso', '') == 'Consulta'
          || profile().get('rol', '') in [
            'Visor provincial AME',
            'Visor zonal AME',
            'Consulta provincial AME'
          ]
        );
    }

    function scopeAllowed(scopeKey) {
      return activeProfile()
        && profile().get('scopeKeys', []) is list
        && scopeKey in profile().get('scopeKeys', []);
    }

    function scopedOperationalWriter(scopeKey) {
      return scopeAllowed(scopeKey) && !readOnlyProfile();
    }

    function allowedOperationalType(value) {
      return value in [
        'sitio', 'infraestructura', 'cartografia', 'accion', 'alojamiento',
        'capacidad', 'recurso', 'seguimiento', 'evidencia', 'decision',
        'validacion', 'actividadcoe', 'fichatecnica', 'plan'
      ];
    }

    function validScopedRecordCreate(scopeKey) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'scopeKey', 'sourceId', 'tipo', 'payload',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'revision'
        ])
        && request.resource.data.get('scopeKey', '') == scopeKey
        && request.resource.data.get('updatedBy', '') == request.auth.token.email
        && request.resource.data.get('createdBy', '') == request.auth.token.email
        && request.resource.data.get('revision', 0) == 1
        && request.resource.data.get('payload', {}) is map
        && allowedOperationalType(request.resource.data.get('tipo', ''));
    }

    function validScopedRecordUpdate(scopeKey) {
      return request.resource.data.get('scopeKey', '') == scopeKey
        && resource.data.get('scopeKey', '') == scopeKey
        && request.resource.data.get('scopeKey', '') == resource.data.get('scopeKey', '')
        && request.resource.data.get('sourceId', '') == resource.data.get('sourceId', '')
        && request.resource.data.get('tipo', '') == resource.data.get('tipo', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('updatedBy', '') == request.auth.token.email
        && request.resource.data.get('revision', 0) == resource.data.get('revision', 0) + 1
        && request.resource.data.get('payload', {}) is map
        && allowedOperationalType(request.resource.data.get('tipo', ''));
    }

    function validChangeCreate(scopeKey) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'scopeKey', 'recordId', 'sourceId', 'tipo',
          'operation', 'revision', 'changedAt', 'changedBy', 'updatedBy'
        ])
        && request.resource.data.get('scopeKey', '') == scopeKey
        && request.resource.data.get('changedBy', '') == request.auth.token.email
        && request.resource.data.get('updatedBy', '') == request.auth.token.email
        && request.resource.data.get('operation', '') in ['create', 'update']
        && allowedOperationalType(request.resource.data.get('tipo', ''));
    }

    function ownPasswordStateUpdate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requiereCambioClave',
          'claveActualizadaEn',
          'ultimoAccesoEn'
        ]);
    }

    // Compatibilidad de lectura durante la migración operativa.
    // La escritura global permanece exclusivamente administrativa.
    match /plataforma/datos {
      allow read: if admin() || activeProfile();
      allow create, update: if admin();
      allow delete: if false;
    }

    // El UID de Authentication es el identificador canónico del perfil.
    match /perfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, delete: if admin();
      allow update: if admin() || ownPasswordStateUpdate(uid);
    }

    // Registro mínimo de actividad. Cada cuenta solo puede escribir su propio UID.
    match /accesos/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if activeProfile()
        && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('correo', '') == request.auth.token.email;
      allow delete: if admin();
    }

    // Registros operativos segmentados por alcance autorizado.
    match /alcances/{scopeKey} {
      allow get, list: if admin() || scopeAllowed(scopeKey);
      allow create, update, delete: if admin();

      match /registros/{recordId} {
        allow read: if admin() || scopeAllowed(scopeKey);
        allow create: if admin()
          || (scopedOperationalWriter(scopeKey) && validScopedRecordCreate(scopeKey));
        allow update: if admin()
          || (scopedOperationalWriter(scopeKey) && validScopedRecordUpdate(scopeKey));
        // El usuario territorial no elimina historia: los cierres se modelan como estado.
        allow delete: if admin();
      }

      // Bitácora append-only. Un cambio autorizado puede crearse, pero no reescribirse.
      match /cambios/{changeId} {
        allow read: if admin() || scopeAllowed(scopeKey);
        allow create: if admin()
          || (scopedOperationalWriter(scopeKey) && validChangeCreate(scopeKey));
        allow update, delete: if false;
      }

      // Overlay heredado: se conserva temporalmente para compatibilidad V11 durante P0.
      match /estado/{stateId} {
        allow read: if admin() || scopeAllowed(scopeKey);
        allow create, update: if admin()
          || (
            scopedOperationalWriter(scopeKey)
            && request.resource.data.get('_scope', {}).get('updatedBy', '') == request.auth.token.email
          );
        allow delete: if admin();
      }
    }

    // Catálogos y procesos administrativos no usados directamente por usuarios finales.
    match /provincias/{document=**} {
      allow read, write: if admin();
    }
    match /territorios/{document=**} {
      allow read, write: if admin();
    }
    match /registros/{document=**} {
      allow read, write: if admin();
    }
    match /migraciones/{document=**} {
      allow read, write: if admin();
    }
    match /respaldos_plataforma/{document=**} {
      allow read, write: if admin();
    }

    // Denegación explícita para cualquier ruta no declarada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
