rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function adminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'geopro.ec2@gmail.com',
          'dcoellom2@unemi.edu.ec',
          'diogenes.coello@gestionderiesgos.gob.ec'
        ];
    }

    function profileExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/perfiles/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/perfiles/$(request.auth.uid)).data;
    }

    function activeProfile() {
      return profileExists() && profile().get('estado', '') == 'Activo';
    }

    function admin() {
      return adminEmail()
        || (activeProfile() && profile().get('rol', '') == 'Administrador');
    }

    function readOnlyProfile() {
      return activeProfile()
        && (
          profile().get('modoAcceso', '') == 'Consulta'
          || profile().get('rol', '') in [
            'Visor provincial AME',
            'Visor zonal AME',
            'Consulta provincial AME'
          ]
        );
    }

    function scopeAllowed(scopeKey) {
      return activeProfile()
        && profile().get('scopeKeys', []) is list
        && scopeKey in profile().get('scopeKeys', []);
    }

    function ownPasswordStateUpdate(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'requiereCambioClave',
          'claveActualizadaEn',
          'ultimoAccesoEn'
        ]);
    }

    // La base global queda reservada a administradores para escritura.
    // Los perfiles territoriales trabajan exclusivamente en su documento de alcance.
    match /plataforma/datos {
      allow read: if admin() || activeProfile();
      allow create, update: if admin();
      allow delete: if false;
    }

    // El UID de Authentication es el identificador canónico del perfil.
    match /perfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, delete: if admin();
      allow update: if admin() || ownPasswordStateUpdate(uid);
    }

    // Registro mínimo de actividad. Cada cuenta solo puede escribir su propio UID.
    match /accesos/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update: if activeProfile()
        && request.auth.uid == uid
        && request.resource.data.get('uid', '') == uid
        && request.resource.data.get('correo', '') == request.auth.token.email;
      allow delete: if admin();
    }

    // Registros y estado operativo segmentados por alcance autorizado.
    match /alcances/{scopeKey} {
      allow get, list: if admin() || scopeAllowed(scopeKey);
      allow create, update, delete: if admin();

      match /registros/{recordId} {
        allow read: if admin() || scopeAllowed(scopeKey);
        allow write: if admin();
      }

      match /estado/{stateId} {
        allow read: if admin() || scopeAllowed(scopeKey);
        allow create, update: if admin()
          || (
            scopeAllowed(scopeKey)
            && !readOnlyProfile()
            && request.resource.data.get('_scope', {}).get('updatedBy', '') == request.auth.token.email
          );
        allow delete: if admin();
      }
    }

    // Catálogos y procesos administrativos no usados directamente por usuarios finales.
    match /provincias/{document=**} {
      allow read, write: if admin();
    }
    match /territorios/{document=**} {
      allow read, write: if admin();
    }
    match /registros/{document=**} {
      allow read, write: if admin();
    }
    match /migraciones/{document=**} {
      allow read, write: if admin();
    }
    match /respaldos_plataforma/{document=**} {
      allow read, write: if admin();
    }

    // Denegación explícita para cualquier ruta no declarada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
